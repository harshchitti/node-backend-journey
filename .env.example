PORT=3000

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cdu_room_booking
DATABASE_URL=postgres://postgres:your_db_password@localhost:5432/cdu_room_booking

# Auth
JWT_SECRET=replace_with_a_long_random_string

# Gmail account used to send OTP emails (use an App Password, not your login password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# JWTs of three verified student accounts and an admin, used only by race-test.js
TOKEN_A=
TOKEN_B=
TOKEN_C=
TOKEN_ADMIN=